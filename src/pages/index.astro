  ---
import Main from "#astro/layouts/main/index.astro";
import PageTitle from "#astro/components/PageTitle.astro";
import Orb from "#astro/components/Orb.astro";
import { SITE_AUTHOR } from "#astro/consts";
---

<style>
  .intro {
    max-width: var(--container);
    margin: 0 auto;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
  }

  .intro p {
    max-width: 38em;
    color: var(--accent);
  }

  .intro p:last-of-type {
    margin-top: 3rem;
  }

  @media screen and (min-width: 768px) {
    .intro {
      padding-right: 20rem;
    }
  }

  @media not (prefers-reduced-motion) {
    .p1,
    .p2,
    .p3,
    .p4 {
      animation: fadeIn 0.5s forwards ease-in;
    }

    .p2 {
      animation-duration: 1s;
    }
    .p3 {
      animation-duration: 1.5s;
    }
    .p4 {
      animation-duration: 2s;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>

<Main title="About" description="A little bit about myself and my work.">
  <PageTitle
    index="About Me"
    kicker="— Introduction"
    title="Daniel Doblado"
  />
  <div class="intro">
    <p class="p1">
      Originally from Spain 🇪🇸 and currently based in Berlin
      🇩🇪, I am a <a target="_blank" href="https://staffeng.com/guides/what-do-staff-engineers-actually-do/">Staff Engineer</a> working at <a
        target="_blank"
        href="https://zattoo.com">Zattoo</a> with passion for tinkering, software and anything that involves understanding processes.
    </p>
    <p class="p2">
      This is my digital notebook for thoughts on code, life, and the process of building anything around me.
    </p>
    <p class="p2">
      From time to time, I <a
        target="_blank"
        href="https://github.com/dobladov/">develop</a
      > personal <a href="/projects">projects</a> or <a href="/blog">write</a>.
    </p>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "http://www.schema.org",
      "@type": "Person",
      "@id": "https://dobla.do/#person",
      name: SITE_AUTHOR,
      alternateName: `${SITE_AUTHOR} Vera`,
      nationality: "Spanish",
      birthPlace: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Málaga",
          addressRegion: "Andalusia",
          addressCountry: "Spain",
        },
      },
      gender: "Male",
      Description: "Technologist, web developer, frontend developer.",
      jobTitle: "Staff Engineer",
      worksFor: [
        {
          "@type": "Organization",
          name: "Zattoo",
          sameAs: [
            "https://zattoo.com/",
            "https://twitter.com/zattoo",
            "https://www.facebook.com/zattoo.de/",
            "https://www.linkedin.com/company/zattoo",
          ],
        },
      ],
      url: "https://dobla.do",
      image: "https://dobla.do/me.png",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Berlin",
        addressRegion: "Berlin",
        addressCountry: "Germany",
      },
      sameAs: [
        "https://codepen.io/dobladov",
        "https://github.com/dobladov",
        "https://stackoverflow.com/users/2498992/daniel-doblado",
        "https://www.youtube.com/channel/UCDSzT113tsecMI4wMh5u0qg",
        "https://www.linkedin.com/in/daniel-doblado-9630191a3",
      ],
    })}
  />
</Main>

<Orb />
