---
// Hand-picked from the blog's tags — the ones that say the most about me
const ringTags = [
  "JavaScript",
  "Software",
  "Development",
  "Writing",
  "Tinkering",
  "Learning",
  "Hardware",
  "Projects"
];

const ringText = ringTags.join(" — ") + " — ";
---

<style>
  aside {
    position: relative;
    padding-top: 8.5rem;
    margin: 0 auto;
    bottom: 0;
    z-index: -1;
  }

  @media screen and (min-width: 768px) {
    aside {
      position: fixed;
      right: -3.5rem;
      margin-right: 6rem;
    }

    @media not (prefers-reduced-motion) {
      aside {
        animation: moveUp 1s ease-out;
      }
      @keyframes moveUp {
        from {
          bottom: -58px;
        }
      }
    }
  }

  img {
    min-width: 16.9rem;
    max-width: 90vw;
  }

  #orb {
    border-radius: 50%;
    bottom: 0;
    width: 16.9rem;
    height: 16.9rem;
    max-width: 16.9rem;
    max-height: 16.9rem;
  }

  .orbContainer {
    position: absolute;
    left: 0;
    border-radius: 50%;
    max-width: 20rem;
    right: 2rem;
    bottom: 14rem;
    opacity: 0.8;
    box-shadow: -3px -2px 5px -1px var(--text);
    width: 16.9rem;
    height: 16.9rem;
    max-width: 16.9rem;
    max-height: 16.9rem;
  }

  .orbContainer:after {
    content: "";
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    border-radius: 50%;
    box-shadow: 7px 6px 15px 13px #3a3a3a94 inset;
  }

  body[data-js="false"] .orbContainer:before {
    content: "";
    border-radius: 50%;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    background: radial-gradient(
        farthest-corner at top,
        #ffffff 0%,
        #ffffff 4%,
        #e4e4e4 12.25%,
        #7c7c7c 31.25%,
        #b1b1b1 50%
      )
      top right/200% 200%;
    animation:
      rotation 5s infinite alternate,
      appear 10s;
  }

  .finger {
    left: 0;
    position: absolute;
    z-index: 1;
    bottom: 6px;
  }

  .ring {
    position: absolute;
    inset: -1.9rem;
    width: calc(100% + 3.8rem);
    height: calc(100% + 3.8rem);
    pointer-events: none;
    overflow: visible;
  }

  .ring text {
    font-family: var(--fontMono);
    font-size: 5.2px;
    text-transform: uppercase;
    fill: var(--text);
  }

  @media not (prefers-reduced-motion) {
    .ring {
      animation: orbit 60s linear infinite;
    }

    @keyframes orbit {
      to {
        transform: rotate(1turn);
      }
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes rotation {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>

<aside>
  <img class="hand" src="/hand.png" alt="Hand" />
  <img class="finger" src="/finger.png" alt="Finger" />
  <div class="orbContainer">
    <canvas id="orb"></canvas>
    <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <path
          id="orbTextPath"
          d="M 50,50 m -46,0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0"
          fill="none"></path>
      </defs>
      <text>
        <textPath href="#orbTextPath" textLength="289" lengthAdjust="spacing"
          >{ringText}</textPath
        >
      </text>
    </svg>
  </div>
</aside>

<script>
  import { map } from "#astro/components/utils";
  class Perlin {
    gradients;
    memory;

    constructor() {
      this.seed();
    }

    rand_vect() {
      let theta = Math.random() * 2 * Math.PI;
      return { x: Math.cos(theta), y: Math.sin(theta) };
    }

    dot_prod_grid(x: number, y: number, vx: number, vy: number) {
      let g_vect;
      let d_vect = { x: x - vx, y: y - vy };
      if (this.gradients[[vx, vy]]) {
        g_vect = this.gradients[[vx, vy]];
      } else {
        g_vect = this.rand_vect();
        this.gradients[[vx, vy]] = g_vect;
      }
      return d_vect.x * g_vect.x + d_vect.y * g_vect.y;
    }

    smootherstep(x: number) {
      return 6 * x ** 5 - 15 * x ** 4 + 10 * x ** 3;
    }

    interp(x: number, a: number, b: number) {
      return a + this.smootherstep(x) * (b - a);
    }

    seed() {
      this.gradients = {};
      this.memory = {};
    }

    get(x: number, y: number) {
      if (this.memory.hasOwnProperty([x, y])) return this.memory[[x, y]];
      let xf = Math.floor(x);
      let yf = Math.floor(y);
      //interpolate
      let tl = this.dot_prod_grid(x, y, xf, yf);
      let tr = this.dot_prod_grid(x, y, xf + 1, yf);
      let bl = this.dot_prod_grid(x, y, xf, yf + 1);
      let br = this.dot_prod_grid(x, y, xf + 1, yf + 1);
      let xt = this.interp(x - xf, tl, tr);
      let xb = this.interp(x - xf, bl, br);
      let v = this.interp(y - yf, xt, xb);
      this.memory[[x, y]] = v;
      return v;
    }
  }

  const canvas = document.getElementById("orb") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  const perlin = new Perlin();
  const totalPoints = 110;
  const noiseScale = 0.012;

  type Particle = {
    x: number;
    y: number;
    px: number;
    py: number;
    ix: number;
    iy: number;
    speed: number;
    lifetime: number;
    maxLifetime: number;
  };

  const particles: Particle[] = [];
  let mouse: { x: number; y: number } | null = null;

  /* Set the size of the canvas for retina displays */
  const scale = () => {
    const width = 500;
    const height = 500;
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    const scale = window.devicePixelRatio;
    canvas.width = Math.floor((width * scale) / 2);
    canvas.height = Math.floor((height * scale) / 2);
  };

  const random = (min: number, max: number) => {
    return Math.random() * (max - min) + min;
  };

  scale();

  // The canvas is square and clipped to a circle, R is both center and radius
  const R = canvas.width / 2;

  const respawn = (p: Particle) => {
    // Uniformly distributed point inside the disk
    const angle = Math.random() * Math.PI * 2;
    const radius = R * 0.95 * Math.sqrt(Math.random());
    p.x = p.px = R + Math.cos(angle) * radius;
    p.y = p.py = R + Math.sin(angle) * radius;
    p.ix = 0;
    p.iy = 0;
    p.speed = random(1, 2.4);
    p.maxLifetime = random(120, 280);
    p.lifetime = p.maxLifetime;
  };

  for (let i = 0; i < totalPoints; i++) {
    const p = {} as Particle;
    respawn(p);
    p.lifetime = random(1, p.maxLifetime); // Desync so they don't die in waves
    particles.push(p);
  }

  const toCanvas = (clientX: number, clientY: number) => {
    const rect = canvas.getBoundingClientRect();
    return {
      x: ((clientX - rect.left) / rect.width) * canvas.width,
      y: ((clientY - rect.top) / rect.height) * canvas.height,
    };
  };

  window.addEventListener("mousemove", (event) => {
    mouse = { x: event.clientX, y: event.clientY };
  });

  // Click: new flow field + shockwave pushing particles away from the cursor
  window.addEventListener("mousedown", (event) => {
    perlin.seed();
    const { x, y } = toCanvas(event.clientX, event.clientY);
    for (const p of particles) {
      const dx = p.x - x;
      const dy = p.y - y;
      const distance = Math.hypot(dx, dy) || 1;
      const force = Math.min(14, (R * 1.2) / distance);
      p.ix += (dx / distance) * force;
      p.iy += (dy / distance) * force;
    }
  });

  const draw = () => {
    // Fade the previous frame instead of clearing, leaving silky trails
    ctx.globalCompositeOperation = "source-over";
    ctx.fillStyle = "rgba(14, 14, 12, 0.08)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Additive blending: overlapping RGB strokes fuse towards white
    ctx.globalCompositeOperation = "lighter";
    ctx.lineCap = "round";

    const m = mouse && toCanvas(mouse.x, mouse.y);

    for (const p of particles) {
      p.lifetime--;

      const distanceToCenter = Math.hypot(p.x - R, p.y - R);

      if (p.lifetime <= 0 || distanceToCenter > R * 0.98) {
        respawn(p);
        continue;
      }

      // 1 at the center, 0 at the rim — fakes the volume of a sphere
      const depth = Math.sqrt(1 - (distanceToCenter / R) ** 2);

      const n = map(perlin.get(p.x * noiseScale, p.y * noiseScale), -1, 1, 0, 1);
      const angle = Math.PI * 2 * n;
      let vx = Math.cos(angle);
      let vy = Math.sin(angle);

      if (m) {
        const dx = m.x - p.x;
        const dy = m.y - p.y;
        const distance = Math.hypot(dx, dy) || 1;

        // Always steer towards the cursor, wherever it is on the page
        vx += (dx / distance) * 1.1;
        vy += (dy / distance) * 1.1;

        // Close to the cursor the flow additionally swirls around it
        const influence = Math.max(0, 1 - distance / (R * 1.2));
        vx += (-dy / distance) * 1.4 * influence;
        vy += (dx / distance) * 1.4 * influence;
      }

      const speed = p.speed * (0.4 + 0.8 * depth);
      p.px = p.x;
      p.py = p.y;
      p.x += vx * speed + p.ix;
      p.y += vy * speed + p.iy;
      p.ix *= 0.88;
      p.iy *= 0.88;

      const fadeIn = Math.min(1, (p.maxLifetime - p.lifetime) / 30);
      const fadeOut = Math.min(1, p.lifetime / 40);
      const alpha = (0.15 + 0.85 * depth) * fadeIn * fadeOut;

      // Chromatic aberration, wider towards the rim like a cheap lens
      const fringe = 0.6 + 2.4 * (1 - depth);
      ctx.lineWidth = 0.6 + 1.6 * depth;

      const channels: Array<[string, number]> = [
        [`rgba(255, 0, 0, ${alpha})`, fringe],
        [`rgba(0, 255, 0, ${alpha})`, 0],
        [`rgba(0, 0, 255, ${alpha})`, -fringe],
      ];

      for (const [color, offset] of channels) {
        ctx.strokeStyle = color;
        ctx.beginPath();
        ctx.moveTo(p.px + offset, p.py);
        ctx.lineTo(p.x + offset, p.y);
        ctx.stroke();
      }
    }

    window.requestAnimationFrame(draw);
  };

  requestAnimationFrame(draw);
</script>
