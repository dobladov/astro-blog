---
import { Icon } from "astro-icon/components";

interface Props {
  logo?: string;
  title: string;
  links?: {
    source?: string;
    live?: string;
  };
}

const { title, links, logo } = Astro.props;
---

<div class="project">
  <div class="header">
    <Icon name={logo} />
    <h3 class="title">{title}</h3>
  </div>

  <div class="body">
    <slot />
  </div>

  {
    links && (
      <div class="links">
        {links.live && (
          <a target="_blank" href={links.live}>
            Live&nbsp;↗
          </a>
        )}
        {links.source && (
          <a target="_blank" href={links.source}>
            Source&nbsp;↗
          </a>
        )}
      </div>
    )
  }
</div>
<style>
  .project {
    display: flex;
    flex-direction: column;
    background-color: var(--background);
    padding: 2rem;
    transition: background-color 250ms ease;
  }

  .project:hover {
    background-color: #131311;
  }

  .header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  svg {
    min-width: 2.75rem;
    max-width: 2.75rem;
    font-size: 2.75rem;
    fill: var(--accent);
  }

  .body {
    flex: 1;
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .links a {
    font-family: var(--fontMono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    background: none;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  .links a:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--background);
  }
</style>
